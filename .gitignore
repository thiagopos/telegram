# .gitignore for Node.js project
# Generated by assistant — ignore common local files and artifacts

# Node dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / process files
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Build output
dist/
build/

# Runtime artifacts
.cache/
tmp/

# Environment files
.env
.env.*

# SQLite DBs (local data)
*.sqlite
*.sqlite3
data/*.sqlite
data/*.sqlite3

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Packages
*.tgz

# Misc
.snyk

# yarn
yarn.lock